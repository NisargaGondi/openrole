# Copy to .env and fill in locally. Never commit .env or service account JSON files.

# --- App ---
APP_ENV=development
DATABASE_URL=sqlite:///./data/openrole.db

# --- LLM provider selection ---
# auto | vertex | fireworks | openrouter | openai
# auto priority: Fireworks → OpenRouter/OpenAI → Vertex (legacy)
LLM_PROVIDER=fireworks

# --- Google Cloud / Vertex AI (Gemini) ---
# Absolute path to service account JSON, OR use: gcloud auth application-default login
GOOGLE_APPLICATION_CREDENTIALS=
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
# gemini-2.5-flash for ingestion; gemini-2.5-pro for outreach writing
VERTEX_MODEL_INGESTION=gemini-2.5-flash
VERTEX_MODEL_DEFAULT=gemini-2.5-flash
VERTEX_MODEL_WRITING=gemini-2.5-pro

VERTEX_MODEL_WRITING=gemini-2.5-pro

# --- Fireworks AI (OpenAI-compatible API) ---
# Copy FIREWORKS_API_KEY from SummerRA/SED/.env or run: python scripts/merge_fireworks_env.py
FIREWORKS_API_KEY=
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
# Per Fireworks recommended models (June 2026):
#   ingestion/format/validate → GLM 5.2 (full JD structure + department/locations)
#   research/web            → Kimi K2.6
#   writing/drafts          → DeepSeek V4 Pro (set glm-5p2 to A/B test)
FIREWORKS_MODEL_INGESTION=accounts/fireworks/models/glm-5p2
FIREWORKS_MODEL_RESEARCH=accounts/fireworks/models/kimi-k2p6
FIREWORKS_MODEL_WRITING=accounts/fireworks/models/deepseek-v4-pro
FIREWORKS_MODEL_DEFAULT=accounts/fireworks/models/deepseek-v4-pro
# Fast/cheap tier — batched email guessing (one call for all contacts)
FIREWORKS_MODEL_FAST=accounts/fireworks/models/deepseek-v4-flash

# --- People discovery ---
# Tavily: LinkedIn people search (primary discovery). See docs/people_discovery_queries.md
TAVILY_API_KEY=
# Apollo: set APOLLO_ENABLED=true only when you have API credits (off by default)
APOLLO_API_KEY=
APOLLO_ENABLED=false
# CareerShift: use CMU browser session for people search when Apollo is off
CAREERSHIFT_PEOPLE_PIPELINE=true
# Persistent browser daemon (auto = use if running, else one-shot launch)
BROWSER_DAEMON_ON_DEMAND=true
CAREERSHIFT_DAEMON=auto
HANDSHAKE_DAEMON=auto
# Visible CareerShift window while daemon runs (false = show window; true = headless)
OPENROLE_CAREERSHIFT_DAEMON_HEADLESS=false
# Auto-stop daemon after idle seconds when started manually (0 = never; on-demand uses 0)
CAREERSHIFT_DAEMON_IDLE_TIMEOUT_S=1800
HANDSHAKE_DAEMON_IDLE_TIMEOUT_S=1800
# CareerShift: local browser login — search-only by default (no detail-view quota burn).
# Set OPENROLE_CAREERSHIFT_SKIP_DETAIL=false to auto-click "View Contact Details".
OPENROLE_CAREERSHIFT_SKIP_DETAIL=true
CMU_EMAIL_DOMAIN=andrew.cmu.edu
CMU_SCHOOL_NAME=Carnegie Mellon

# --- OpenAI-compatible LLM (when Vertex / Fireworks not used) ---
OPENAI_API_KEY=
OPENAI_API_BASE=https://openrouter.ai/api/v1
OPENAI_MODEL_INGESTION=moonshotai/kimi-k2.6:free
OPENAI_MODEL_DEFAULT=moonshotai/kimi-k2.6:free
OPENAI_MODEL_WRITING=moonshotai/kimi-k2.6:free

# --- Candidate profile (outreach drafts) ---
# Comma-separated .pdf/.md paths, or one folder (loads all *.pdf inside)
CANDIDATE_NAME=
CANDIDATE_RESUME_PATHS=
CANDIDATE_LINKEDIN_URL=
CANDIDATE_GITHUB_URL=
CANDIDATE_WEBSITE_URL=
# Outreach closing line — edit month/year anytime (e.g. December 2026)
CANDIDATE_GRADUATION=December 2026
CANDIDATE_ROLE_SEARCH=machine learning engineer, AI security engineer, cybersecurity engineer, software engineer
CANDIDATE_VISA_STATUS=F-1 OPT

# --- Sync (Phase B) ---
NOTION_API_KEY=
NOTION_JOBS_DATABASE_ID=
# Match your Notion database column names (defaults shown):
NOTION_PROP_TITLE=Name
NOTION_PROP_COMPANY=Company
NOTION_PROP_URL=URL
NOTION_PROP_SCORE=Score
NOTION_PROP_STATUS=Status
# NOTION_PROP_SOURCE=Source
# NOTION_PROP_OPT=OPT Status
GOOGLE_SHEETS_CREDENTIALS_JSON=
GOOGLE_SHEETS_SPREADSHEET_ID=

# --- Job Scout (Phase B) ---
# Filters are derived from the resume you select in the Scout UI (not hardcoded families).
# OPT/sponsorship mention is mandatory by default (F-1).
SCOUT_REQUIRE_OPT_MENTION=false
# Default resume for scheduled runs (match a label from CANDIDATE_RESUME_PATHS)
SCOUT_DEFAULT_RESUME_LABEL=resume_ML.pdf
SCOUT_COMPANIES_PER_RUN=15
# Skip scout jobs requiring more YOE than you have (Principal/Staff/8+ years JDs)
SCOUT_FILTER_EXPERIENCE=true
SCOUT_EXPERIENCE_SLACK_YEARS=1
# Override auto-estimate from resume (e.g. 2 for MS + internships)
CANDIDATE_YEARS_EXPERIENCE=
SCOUT_COMPANY_RESCOUT_HOURS=48
SCOUT_TAVILY_ENABLED=true
SCOUT_TAVILY_COMPANIES_PER_RUN=12
SCOUT_MIN_RELEVANCE_SCORE=45
SCOUT_RESUME_ANALYSIS_THRESHOLD=70
SCOUT_RESULTS_PER_TERM=20
SCOUT_INGESTION_BATCH_SIZE=6
# Scout prepare: parallel refetch (HTTP) and LLM batch workers (I/O-bound)
SCOUT_REFETCH_PARALLEL_WORKERS=8
SCOUT_LLM_PARALLEL_WORKERS=4
SCOUT_SEARCH_LOCATION=United States

# --- Browser automation (Handshake / CareerShift) ---
# Handshake blocks headless sessions (Cloudflare) — keep false for scout/search.
# CareerShift defaults to headless; set false if login or scraping fails.
OPENROLE_HANDSHAKE_HEADLESS=false
OPENROLE_CAREERSHIFT_HEADLESS=true
